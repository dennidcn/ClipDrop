{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipDrop",
  "version": "0.3.1",
  "identifier": "com.clipdrop.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ClipDrop",
        "width": 460,
        "height": 680,
        "minWidth": 380,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4MEZCRjJCNEYyM0ExMDQKUldRRW9TTlBLNzhQbUxRK2M4SUk0Y3QyK0ZSNFNoaXBxSE5DSWdJYnRkZGJZL0NxcXoxZmdFd1AK",
      "endpoints": [
        "https://github.com/dennidcn/ClipDrop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
